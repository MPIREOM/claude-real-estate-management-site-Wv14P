<%- include('../partials/header') %>

<div class="page-header">
  <h1><%= request ? 'Edit' : 'New' %> Maintenance Request</h1>
</div>

<div class="card">
  <div class="card-header">
    <%= request ? 'Edit Maintenance Request' : 'Create Maintenance Request' %>
  </div>
  <div class="card-body">
    <form action="<%= request ? '/maintenance/' + request.id : '/maintenance' %>" method="POST">

      <div class="form-row">
        <div class="form-group">
          <label for="unit_id">Unit</label>
          <select name="unit_id" id="unit_id" class="form-control" required>
            <option value="">Select a unit</option>
            <% units.forEach(function(unit) { %>
              <option value="<%= unit.id %>"
                <% if (request && request.unit_id === unit.id) { %>
                  selected
                <% } else if (!request && preselectedUnitId && preselectedUnitId == unit.id) { %>
                  selected
                <% } %>
              ><%= unit.property_name %> - <%= unit.unit_number %></option>
            <% }); %>
          </select>
        </div>

        <div class="form-group">
          <label for="tenant_id">Tenant (Optional)</label>
          <select name="tenant_id" id="tenant_id" class="form-control">
            <option value="">No tenant</option>
            <% tenants.forEach(function(tenant) { %>
              <option value="<%= tenant.id %>"
                <% if (request && request.tenant_id === tenant.id) { %>
                  selected
                <% } else if (!request && preselectedTenantId && preselectedTenantId == tenant.id) { %>
                  selected
                <% } %>
              ><%= tenant.first_name %> <%= tenant.last_name %></option>
            <% }); %>
          </select>
        </div>
      </div>

      <div class="form-group">
        <label for="title">Title</label>
        <input type="text" name="title" id="title" class="form-control" value="<%= request ? request.title : '' %>" required>
      </div>

      <div class="form-group">
        <label for="description">Description</label>
        <textarea name="description" id="description" class="form-control" rows="5" required><%= request ? request.description : '' %></textarea>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label for="priority">Priority</label>
          <select name="priority" id="priority" class="form-control" required>
            <option value="low" <%= request && request.priority === 'low' ? 'selected' : '' %>>Low</option>
            <option value="medium" <%= (!request || request.priority === 'medium') ? 'selected' : '' %>>Medium</option>
            <option value="high" <%= request && request.priority === 'high' ? 'selected' : '' %>>High</option>
            <option value="urgent" <%= request && request.priority === 'urgent' ? 'selected' : '' %>>Urgent</option>
          </select>
        </div>

        <% if (request) { %>
          <div class="form-group">
            <label for="status">Status</label>
            <select name="status" id="status" class="form-control" required>
              <option value="open" <%= request.status === 'open' ? 'selected' : '' %>>Open</option>
              <option value="in_progress" <%= request.status === 'in_progress' ? 'selected' : '' %>>In Progress</option>
              <option value="completed" <%= request.status === 'completed' ? 'selected' : '' %>>Completed</option>
              <option value="closed" <%= request.status === 'closed' ? 'selected' : '' %>>Closed</option>
            </select>
          </div>
        <% } %>
      </div>

      <div class="actions">
        <button type="submit" class="btn btn-primary"><%= request ? 'Update' : 'Create' %> Request</button>
        <a href="/maintenance" class="btn btn-secondary">Cancel</a>
        <% if (request) { %>
          <form action="/maintenance/<%= request.id %>/delete" method="POST" style="display:inline;">
            <button type="submit" class="btn btn-danger confirm-delete">Delete</button>
          </form>
        <% } %>
      </div>

    </form>
  </div>
</div>

<%- include('../partials/footer') %>
