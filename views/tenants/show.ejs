<%- include('../partials/header') %>

<div class="page-header">
  <h1><%= tenant.first_name %> <%= tenant.last_name %></h1>
  <div class="actions">
    <a href="/tenants/<%= tenant.id %>/edit" class="btn btn-secondary">Edit</a>
    <form action="/tenants/<%= tenant.id %>/delete" method="POST" class="confirm-delete" style="display:inline;">
      <button type="submit" class="btn btn-danger">Delete</button>
    </form>
  </div>
</div>

<!-- Tenant Details -->
<div class="card">
  <div class="card-header">
    <h2>Contact Information</h2>
  </div>
  <div class="card-body">
    <div class="detail-grid">
      <div class="detail-list">
        <strong>First Name:</strong>
        <span><%= tenant.first_name %></span>
      </div>
      <div class="detail-list">
        <strong>Last Name:</strong>
        <span><%= tenant.last_name %></span>
      </div>
      <div class="detail-list">
        <strong>Email:</strong>
        <span><%= tenant.email %></span>
      </div>
      <div class="detail-list">
        <strong>Phone:</strong>
        <span><%= tenant.phone || '-' %></span>
      </div>
      <div class="detail-list">
        <strong>Emergency Contact:</strong>
        <span><%= tenant.emergency_contact || '-' %></span>
      </div>
      <div class="detail-list">
        <strong>Emergency Phone:</strong>
        <span><%= tenant.emergency_phone || '-' %></span>
      </div>
      <div class="detail-list">
        <strong>Notes:</strong>
        <span><%= tenant.notes || '-' %></span>
      </div>
    </div>
  </div>
</div>

<!-- Leases -->
<h2 class="section-title">Leases</h2>

<% if (leases && leases.length > 0) { %>
  <table class="table">
    <thead>
      <tr>
        <th>Property</th>
        <th>Unit</th>
        <th>Start Date</th>
        <th>End Date</th>
        <th>Rent Amount</th>
        <th>Payment Frequency</th>
        <th>Status</th>
      </tr>
    </thead>
    <tbody>
      <% leases.forEach(function(lease) { %>
        <tr>
          <td><%= lease.property_name %></td>
          <td><%= lease.unit_number %></td>
          <td><%= lease.start_date %></td>
          <td><%= lease.end_date %></td>
          <td>$<%= parseFloat(lease.rent_amount).toFixed(2) %></td>
          <td><%= lease.payment_frequency %></td>
          <td>
            <% if (lease.status === 'active') { %>
              <span class="badge badge-success"><%= lease.status %></span>
            <% } else if (lease.status === 'pending') { %>
              <span class="badge badge-warning"><%= lease.status %></span>
            <% } else if (lease.status === 'terminated') { %>
              <span class="badge badge-danger"><%= lease.status %></span>
            <% } else { %>
              <span class="badge badge-secondary"><%= lease.status %></span>
            <% } %>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
<% } else { %>
  <div class="empty-state">
    <p>No leases found for this tenant.</p>
  </div>
<% } %>

<!-- Recent Payments -->
<h2 class="section-title">Recent Payments</h2>

<% if (payments && payments.length > 0) { %>
  <table class="table">
    <thead>
      <tr>
        <th>Due Date</th>
        <th>Amount Due</th>
        <th>Amount Paid</th>
        <th>Status</th>
        <th>Property</th>
        <th>Unit</th>
      </tr>
    </thead>
    <tbody>
      <% payments.forEach(function(payment) { %>
        <tr>
          <td><%= payment.due_date %></td>
          <td>$<%= parseFloat(payment.amount_due).toFixed(2) %></td>
          <td>$<%= parseFloat(payment.amount_paid).toFixed(2) %></td>
          <td>
            <% if (payment.status === 'paid') { %>
              <span class="badge badge-success"><%= payment.status %></span>
            <% } else if (payment.status === 'pending') { %>
              <span class="badge badge-warning"><%= payment.status %></span>
            <% } else if (payment.status === 'overdue') { %>
              <span class="badge badge-danger"><%= payment.status %></span>
            <% } else if (payment.status === 'partial') { %>
              <span class="badge badge-info"><%= payment.status %></span>
            <% } else { %>
              <span class="badge badge-secondary"><%= payment.status %></span>
            <% } %>
          </td>
          <td><%= payment.property_name %></td>
          <td><%= payment.unit_number %></td>
        </tr>
      <% }); %>
    </tbody>
  </table>
<% } else { %>
  <div class="empty-state">
    <p>No payments found for this tenant.</p>
  </div>
<% } %>

<!-- Maintenance Requests -->
<h2 class="section-title">Maintenance Requests</h2>

<% if (maintenanceRequests && maintenanceRequests.length > 0) { %>
  <table class="table">
    <thead>
      <tr>
        <th>Title</th>
        <th>Property</th>
        <th>Unit</th>
        <th>Priority</th>
        <th>Status</th>
      </tr>
    </thead>
    <tbody>
      <% maintenanceRequests.forEach(function(request) { %>
        <tr>
          <td><%= request.title %></td>
          <td><%= request.property_name %></td>
          <td><%= request.unit_number %></td>
          <td>
            <% if (request.priority === 'high' || request.priority === 'urgent') { %>
              <span class="badge badge-danger"><%= request.priority %></span>
            <% } else if (request.priority === 'medium') { %>
              <span class="badge badge-warning"><%= request.priority %></span>
            <% } else { %>
              <span class="badge badge-info"><%= request.priority %></span>
            <% } %>
          </td>
          <td>
            <% if (request.status === 'completed') { %>
              <span class="badge badge-success"><%= request.status %></span>
            <% } else if (request.status === 'in_progress') { %>
              <span class="badge badge-info"><%= request.status %></span>
            <% } else if (request.status === 'open') { %>
              <span class="badge badge-warning"><%= request.status %></span>
            <% } else { %>
              <span class="badge badge-secondary"><%= request.status %></span>
            <% } %>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
<% } else { %>
  <div class="empty-state">
    <p>No maintenance requests found for this tenant.</p>
  </div>
<% } %>

<div class="actions" style="margin-top: 1rem;">
  <a href="/tenants" class="btn btn-secondary">Back to Tenants</a>
</div>

<%- include('../partials/footer') %>
